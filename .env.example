# Email nhac lich (vd Gmail: smtp.gmail.com / 587 / App Password)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@giapha.example.com

# Telegram bot (tao qua @BotFather). Chat ID nhom duoc cau hinh trong trang Quan tri dong ho.
TELEGRAM_BOT_TOKEN=
