# Sao chep thanh .env va sua lai truoc khi chay production
DB_USER=giapha
DB_PASSWORD=doi-mat-khau-db
JWT_SECRET=chuoi-bi-mat-ngau-nhien-dai-it-nhat-32-ky-tu
CORS_ORIGINS=https://giapha.example.com

SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=doi-mat-khau-admin

# true: dong ho moi tao duoc kich hoat ngay; false: cho Super Admin duyet
